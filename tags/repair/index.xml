&lt;script type="module">
import * as THREE from 'three';
import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
import { MeshoptDecoder } from 'three/addons/libs/meshopt_decoder.module.js';
import { DRACOLoader } from 'three/addons/loaders/DRACOLoader.js'
let container;
let camera, scene, renderer, clock;
let mesh;
let rotate, controls;
init();
render();
function init() {
container = document.getElementById("coarse_hameg_knob_6.1mm_open_nut.glb");
container.onload = () => {
onWindowResize();
}
const aspectRatio = "1";
const model_path = "coarse_hameg_knob_6.1mm_open_nut.glb";
const modelColor = "#7c695a";
rotate = "true" === "true";
renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
renderer.setPixelRatio(window.devicePixelRatio);
renderer.setSize(container.clientWidth, container.clientWidth / aspectRatio);
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1;
renderer.outputColorSpace = THREE.SRGBColorSpace;
container.appendChild(renderer.domElement);
camera = new THREE.PerspectiveCamera(45, aspectRatio, 0.1, 1000);
camera.position.set(1, 0, 1);
camera.lookAt(0, 0, 0);
controls = new OrbitControls(camera, renderer.domElement);
controls.addEventListener('change', render);
controls.minDistance = 1;
controls.maxDistance = 10;
controls.target.set(0, 0, 0);
controls.update();
const environment = new RoomEnvironment(renderer);
const pmremGenerator = new THREE.PMREMGenerator(renderer);
scene = new THREE.Scene();
scene.environment = pmremGenerator.fromScene(environment).texture;
const ambientLight = new THREE.AmbientLight(0xffffff, 1);
scene.add(ambientLight);
const light1 = new THREE.PointLight( 0xffeeee, 50, 0);
light1.position.set( 0, 2, 1 );
light1.castShadow = true;
scene.add( light1 );
const loader = new GLTFLoader();
const dracoLoader = new DRACOLoader();
dracoLoader.setDecoderPath('/examples/jsm/libs/draco/');
loader.setMeshoptDecoder(MeshoptDecoder);
loader.setDRACOLoader(dracoLoader);
loader.load(model_path, function (gltf) {
const root = gltf.scene;
const box = new THREE.Box3().setFromObject(root);
const size = box.getSize(new THREE.Vector3());
const center = box.getCenter(new THREE.Vector3());
root.position.x += (root.position.x - center.x);
root.position.y += (root.position.y - center.y);
root.position.z += (root.position.z - center.z);
mesh = new THREE.Group();
mesh.add(root);
if (modelColor &amp;&amp; modelColor !== "") {
root.traverse((child) => {
if (child.isMesh) {
child.material.color.set(modelColor);
child.material.roughness = 0.8;
child.material.metalness = 0.2;
}
});
}
root.traverse((child) => {
if (child.isMesh) {
child.castShadow = true;
child.receiveShadow = true;
}
});
const maxSize = Math.max(size.x, size.y, size.z);
mesh.scale.set(1 / maxSize, 1 / maxSize, 1 / maxSize);
scene.add(mesh);
if ( rotate ) {
clock = new THREE.Clock();
renderer.setAnimationLoop( animate );
controls.addEventListener( 'start', () => rotate = false );
controls.addEventListener( 'end', () => rotate = true );
}
render();
});
window.addEventListener('resize', onWindowResize);
}
function onWindowResize() {
const aspectRatio = "1";
camera.aspect = aspectRatio;
camera.updateProjectionMatrix();
renderer.setSize(container.clientWidth, container.clientWidth / aspectRatio);
render();
}
function render() {
renderer.render(scene, camera);
}
function animate() {
const delta = clock.getDelta();
const direction = "left";
if ( rotate &amp;&amp; mesh ) {
const ry = 0.5;
if (direction === "left") {
mesh.rotation.y -= delta * ry;
} else {
mesh.rotation.y += delta * ry;
}
render();
}
}
&lt;/script>
