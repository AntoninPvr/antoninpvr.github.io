&lt;div>&lt;div class="highlight">&lt;pre tabindex="0" class="chroma">&lt;code class="language-zsh" data-lang="zsh">&lt;span class="line">&lt;span class="cl">&lt;span class="o">======================&lt;/span> BATTERY &lt;span class="nv">LOGGER&lt;/span> &lt;span class="o">=====================&lt;/span>
