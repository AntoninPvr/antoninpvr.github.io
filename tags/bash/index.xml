&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">&lt;span class="p">|&lt;/span> Metric &lt;span class="p">|&lt;/span> Value &lt;span class="o">(&lt;/span>converted&lt;span class="o">)&lt;/span> &lt;span class="p">|&lt;/span> Raw Value &lt;span class="p">|&lt;/span>
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">&lt;span class="p">|&lt;/span>----------------&lt;span class="p">|&lt;/span>--------------------&lt;span class="p">|&lt;/span>-------------------&lt;span class="p">|&lt;/span>
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">&lt;span class="p">|&lt;/span> current_now &lt;span class="p">|&lt;/span> 1089.000 mA &lt;span class="p">|&lt;/span> &lt;span class="m">1089000&lt;/span> &lt;span class="p">|&lt;/span>
